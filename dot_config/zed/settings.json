{
  "auto_install_extensions": {
    "html": true,
    "git-firefly": true,
    "toml": true,
    "dockerfile": true,
    "catppuccin": true,
    "vue": true,
    "catppuccin-icons": true,
    "lua": true,
    "astro": true,
    "prisma": true,
    "fish": true,
    "templ": true,
    "xml": true,
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
  },
  "buffer_font_family": "SpaceMono Nerd Font Mono",
  "buffer_font_fallbacks": ["Noto Sans Mono CJK JP", "Noto Color Emoji"],
  "minimap": {
    "show": "auto",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "tab_size": 2,
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware",
  },
  "project_panel": {
    "dock": "left",
  },
  "diff_view_style": "unified",
  "terminal": {
    "dock": "bottom",
    "font_family": "SpaceMono Nerd Font Mono",
    "font_fallbacks": ["Noto Sans Mono CJK JP", "Noto Color Emoji"],
    "line_height": "standard",
  },
  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "dock": "left",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "ui_font_family": "SpaceMono Nerd Font",
  "ui_font_fallbacks": ["Noto Sans Mono CJK JP", "Noto Color Emoji"],
  "ui_font_size": 14.0,
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Frappé",
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
  },
}

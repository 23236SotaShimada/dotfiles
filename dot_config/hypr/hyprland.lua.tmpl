bind(mainMod .. " + M", hl.dsp.workspace.toggle_special("scratchpad"), "スクラッチパッドを表示 / 非表示")
bind(mainMod .. " + SHIFT + M", hl.dsp.window.move({ workspace = "special:scratchpad" }), "ウィンドウをスクラッチパッドへ移動")
bind(mainMod .. " + ALT + SHIFT + M", function()
    local window = hl.get_active_window()
    if window == nil or window.workspace == nil or not window.workspace.special then
        return
    end

    local monitor = window.monitor
    local workspace = monitor ~= nil and monitor.active_workspace or nil
    if workspace == nil or workspace.special then
        return
    end

    hl.dispatch(hl.dsp.window.move({ workspace = workspace, window = window }))
end, "特殊ワークスペースから通常ワークスペースへ戻す")


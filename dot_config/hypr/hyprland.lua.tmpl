local function bind(keys, action, description, options)
    local bindOptions = {}
    for key, value in pairs(options or {}) do
        bindOptions[key] = value
    end
    bindOptions.description = description
    return hl.bind(keys, action, bindOptions)
end

local function isGhostty(window)
    return window ~= nil and string.find(string.lower(window.class), "ghostty", 1, true) ~= nil
end

local function isZed(window)
    if window == nil then
        return false
    end

    local class = string.lower(window.class)
    return class == "zed" or class == "zed-editor" or string.find(class, "dev.zed.zed", 1, true) == 1
end

local function sendShortcut(window, mods, key)
    hl.dispatch(hl.dsp.send_key_state({
        mods = mods,
        key = key,
        state = "down",
        window = window,
    }))
    hl.dispatch(hl.dsp.send_key_state({
        mods = mods,
        key = key,
        state = "up",
        window = window,
    }))
end

local function bindCommand(input, output, options)
    options = options or {}

    bind(mainMod .. " + " .. input, function()
        local window = hl.get_active_window()
        if window == nil then
            return
        end

        if isGhostty(window) then
            if options.ghostty == nil then
                return
            end
            sendShortcut(window, options.ghostty.mods, options.ghostty.key or output)
            return
        end

        if isZed(window) and options.zed ~= nil then
            sendShortcut(window, options.zed.mods, options.zed.key or output)
            return
        end

        sendShortcut(window, options.mods or "CTRL", output)
    end, "アプリへ送信: " .. (options.mods or "CTRL") .. " + " .. output .. "（Ghostty / Zed は個別設定）")
end

local function bindOption(input, output)
    bind("ALT + " .. input, function()
        local window = hl.get_active_window()
        if window ~= nil then
            sendShortcut(window, "CTRL", output)
        end
    end, "単語単位の移動 / 削除: CTRL + " .. output, { repeating = true })
end

local function bindEmacs(input, output, mods)
    bind("CTRL + " .. input, function()
        local window = hl.get_active_window()
        if window == nil then
            return
        end

        if isGhostty(window) then
            sendShortcut(window, "CTRL", input)
            return
        end

        sendShortcut(window, mods or "", output)
    end, "Emacs 操作: " .. (mods or "") .. " " .. output .. "（Ghostty では CTRL + " .. input .. "）", { repeating = true })
end


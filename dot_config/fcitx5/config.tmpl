{{- $keyboardType := "Japanese" -}}
{{- if hasKey . "keyboardType" -}}
{{-   $keyboardType = index . "keyboardType" -}}
{{- end -}}
{{- $jis := or (eq $keyboardType "Japanese") (eq $keyboardType "Mac Japanese") -}}
[Hotkey/TriggerKeys]

[Hotkey/AltTriggerKeys]

[Hotkey/EnumerateGroupForwardKeys]

[Hotkey/EnumerateGroupBackwardKeys]

[Hotkey/ActivateKeys]
{{ if eq $keyboardType "Mac Japanese" -}}
0=Hangul
{{ else -}}
0={{ if $jis }}Henkan{{ else }}F14{{ end }}
{{ end -}}
{{ if eq $keyboardType "Japanese" -}}
1=Hiragana_Katakana
{{ end }}

[Hotkey/DeactivateKeys]
0={{ if eq $keyboardType "Mac Japanese" }}Hangul_Hanja{{ else if $jis }}Muhenkan{{ else }}F13{{ end }}

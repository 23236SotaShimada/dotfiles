{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/launcher", "custom/workspaces"],
  "modules-center": ["custom/media-previous", "image#media-art", "custom/media-play", "custom/media-next"],
  "modules-right": ["tray", "network", "bluetooth", "pulseaudio", "idle_inhibitor", "battery", "custom/date"],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power-menu.xml",
    "menu-actions": {
      "lock": "$HOME/.local/bin/power-menu lock",
      "suspend": "$HOME/.local/bin/power-menu suspend",
      "logout": "$HOME/.local/bin/power-menu logout",
      "reboot": "$HOME/.local/bin/power-menu reboot",
      "poweroff": "$HOME/.local/bin/power-menu poweroff"
    }
  },
  "custom/workspaces": {
    "exec": "$HOME/.local/bin/waybar-workspaces",
    "format": "{}",
    "interval": 1,
    "escape": false,
    "tooltip": false
  },
  "image#media-art": {
    "exec": "$HOME/.local/bin/waybar-media-art",
    "size": 24,
    "interval": 2,
    "tooltip": false,
    "on-click": "playerctl --player=playerctld play-pause"
  },
  "custom/media-previous": {
    "exec": "if playerctl --player=playerctld status >/dev/null 2>&1; then printf '󰒮\\n'; fi",
    "format": "{}",
    "interval": 1,
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "playerctl --player=playerctld previous"
  },
  "custom/media-play": {
    "exec": "status=$(playerctl --player=playerctld status 2>/dev/null || :); [ -n \"$status\" ] || exit 0; art_url=$(playerctl --player=playerctld metadata --format '{{mpris:artUrl}}' 2>/dev/null || :); [ -n \"$art_url\" ] || printf '󰐊\\n'",
    "format": "{}",
    "interval": 2,
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "playerctl --player=playerctld play-pause",
    "on-click-middle": "playerctl --player=playerctld previous",
    "on-click-right": "playerctl --player=playerctld next"
  },
  "custom/media-next": {
    "exec": "if playerctl --player=playerctld status >/dev/null 2>&1; then printf '󰒭\\n'; fi",
    "format": "{}",
    "interval": 1,
    "hide-empty-text": true,
    "tooltip": false,
    "on-click": "playerctl --player=playerctld next"
  },
  "custom/date": {
    "exec": "$HOME/.local/bin/waybar-date",
    "format": "{}",
    "interval": 30,
    "tooltip": false
  },
  "network": {
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}: {status}",
    "tooltip-format-connected": "{controller_alias}: {status}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "hyprpwcenter"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "enable",
    "tooltip-format-deactivated": "disable"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },
  "tray": {
    "spacing": 12
  }
}

{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/bin/sh
set -eu

sudo pacman -S --needed --noconfirm \
  blueman \
  bluez \
  bluez-utils \
  btop \
  brightnessctl \
  cliphist \
  curl \
  fcitx5 \
  fcitx5-gtk \
  fcitx5-qt \
  fcitx5-skk \
  firefox \
  fuzzel \
  ghostty \
  grim \
  gvfs \
  hyprland \
  hypridle \
  hyprlock \
  hyprpwcenter \
  imagemagick \
  ly \
  mako \
  networkmanager \
  nm-connection-editor \
  noto-fonts-cjk \
  noto-fonts-emoji \
  nwg-look \
  pipewire \
  pipewire-pulse \
  playerctl \
  slurp \
  starship \
  terminus-font \
  thunar \
  thunar-archive-plugin \
  thunar-volman \
  ttf-liberation \
  ttf-space-mono-nerd \
  tumbler \
  vim \
  waybar \
  wireplumber \
  wl-clipboard \
  xarchiver \
  xdg-utils \
  zed \
  zsh \
  zsh-autosuggestions \
  zsh-completions \
  zsh-syntax-highlighting

if [ "${SHELL:-}" != /usr/bin/zsh ]; then
  chsh -s /usr/bin/zsh
fi

sudo systemctl disable getty@tty2.service
sudo systemctl enable --now bluetooth.service
sudo systemctl enable ly@tty2.service
sudo systemctl enable NetworkManager.service
{{ end -}}

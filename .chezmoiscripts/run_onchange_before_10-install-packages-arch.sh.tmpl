{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "arch") -}}
#!/bin/sh
set -eu

sudo pacman -S --needed --noconfirm \
  btop \
  cliphist \
  fcitx5 \
  fcitx5-gtk \
  fcitx5-qt \
  fcitx5-skk \
  firefox \
  fuzzel \
  ghostty \
  hyprland \
  hypridle \
  hyprlock \
  hyprpwcenter \
  ly \
  mako \
  networkmanager \
  nm-connection-editor \
  noto-fonts-cjk \
  noto-fonts-emoji \
  nwg-look \
  pipewire \
  pipewire-pulse \
  starship \
  thunar \
  ttf-liberation \
  ttf-space-mono-nerd \
  vim \
  waybar \
  wireplumber \
  wl-clipboard \
  xdg-utils \
  zed \
  zsh \
  zsh-autosuggestions \
  zsh-completions \
  zsh-syntax-highlighting

if [ "${SHELL:-}" != /usr/bin/zsh ]; then
  chsh -s /usr/bin/zsh
fi

sudo systemctl disable getty@tty2.service
sudo systemctl enable ly@tty2.service
sudo systemctl enable NetworkManager.service
{{ end -}}

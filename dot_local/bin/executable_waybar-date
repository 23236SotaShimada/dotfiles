#!/bin/sh
set -eu

calendar_date="$(date +%Y%m%d)"
year="$(date +%Y)"
month="$(date +%m | sed 's/^0//')"
day="$(date +%d | sed 's/^0//')"

if [ "$calendar_date" -ge 20190501 ]; then
  era=Reiwa
  era_year=$((year - 2018))
elif [ "$calendar_date" -ge 19890108 ]; then
  era=Heisei
  era_year=$((year - 1988))
elif [ "$calendar_date" -ge 19261225 ]; then
  era=Showa
  era_year=$((year - 1925))
else
  era=Taisho
  era_year=$((year - 1911))
fi

case "$(date +%w)" in
  0) weekday=Sun ;;
  1) weekday=Mon ;;
  2) weekday=Tue ;;
  3) weekday=Wed ;;
  4) weekday=Thu ;;
  5) weekday=Fri ;;
  6) weekday=Sat ;;
esac

date_text="$(printf '%s %s/%s/%s (%s) %s' "$era" "$era_year" "$month" "$day" "$weekday" "$(date +%H:%M)")"
notification_count="$(timeout 1s swaync-client --count 2>/dev/null || :)"

case "$notification_count" in
  ''|*[!0-9]*) printf '{"text":"%s"}\n' "$date_text" ;;
  *)
    if [ "$notification_count" -gt 0 ]; then
      printf '{"text":"%s","class":"unread"}\n' "$date_text"
    else
      printf '{"text":"%s"}\n' "$date_text"
    fi
    ;;
esac

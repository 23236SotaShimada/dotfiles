#!/bin/sh
set -eu

case "${1:-}" in
  full)
    grim - | wl-copy --type image/png
    ;;
  region)
    geometry="$(slurp)" || exit 0
    [ -n "$geometry" ] || exit 0
    grim -g "$geometry" - | wl-copy --type image/png
    ;;
  *)
    printf 'usage: %s full|region\n' "$0" >&2
    exit 2
    ;;
esac
